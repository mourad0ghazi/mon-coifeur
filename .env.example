# Secrets obligatoires (générer au moins 32 octets aléatoires en production)
AUTH_SECRET=change-me-with-a-long-random-secret
OTP_PEPPER=change-me-with-another-random-secret

# OAuth — créer les applications dans Google Cloud, Meta Developers et Apple Developer
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# PostgreSQL 15+ avec PostGIS et btree_gist
DATABASE_URL=postgresql://hlaqti:password@localhost:5432/hlaqti

# WhatsApp Business Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# Template approuvé Meta pour le message de validation partenaire (optionnel en démo)
WHATSAPP_VALIDATION_TEMPLATE_NAME=partner_validated

# URLs publiques
NEXT_PUBLIC_APP_URL=http://localhost:3000
TZ=Africa/Casablanca

# Google Maps Platform — active Places API pour l'autocomplétion
# (restreindre la clé au Maroc / à ton domaine dans Google Cloud Console)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
